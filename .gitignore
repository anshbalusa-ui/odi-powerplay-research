.DS_Store
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Raw and derived datasets are reproduced by scripts.
data/raw/cricsheet/*
data/interim/*
data/processed/*
!data/**/.gitkeep
!data/manual/*_template.csv

# Local pitch-research working files may contain source-derived notes that are
# not cleared for redistribution. Publish only after a separate rights review.
data/manual/pitch_reports.csv
data/manual/pitch_collection_queue.xlsx
data/manual/pitch_batch_working*.csv
data/manual/*.inspect.ndjson

# Generated artifacts
artifacts/run_manifest.json
artifacts/figures/*
artifacts/models/*
artifacts/tables/*
!artifacts/**/.gitkeep
